<section class="onlineconf__panel" aria-labelledby="page-title">
  <h1 id="page-title" tabindex="-1">{{title}}</h1>
  {{#if description}}
    <p class="onlineconf__description">{{description}}</p>
  {{/if}}
  {{#if id}}
    <p class="onlineconf__description">ID: {{id}}</p>
  {{/if}}
  <div data-page-content></div>
  {{#if notFound}}
    <a href="/onlineconf/" data-onlineconf-link>К каталогу</a>
  {{/if}}
</section>