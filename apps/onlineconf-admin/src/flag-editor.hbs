<fieldset class="flag-editor">
  <legend>Настройки флага</legend>

  <label>
    <input type="checkbox" data-flag-enabled />
    Флаг включён
  </label>

  <div class="flag-editor__row">
    <label>
      Процент раскатки
      <input type="range" min="0" max="100" step="1" data-flag-range />
    </label>
    <label>
      Процент вручную
      <input type="number" min="0" max="100" step="1" required data-flag-percent />
    </label>
  </div>

  <p class="flag-editor__hint">
    Процент применяется к пользователям вне персональных списков. Выключенный флаг недоступен всем.
  </p>

  <div class="flag-editor__row">
    <label>
      Поиск пользователя по логину
      <input type="search" autocomplete="off" data-flag-query />
    </label>
    <button type="button" data-flag-search>Найти</button>
  </div>

  <p role="status" data-flag-search-status></p>
  <ul class="flag-editor__results" aria-label="Результаты поиска" data-flag-results></ul>

  <div class="flag-editor__lists">
    <section aria-label="Принудительно включить">
      <h3>Принудительно включить <span data-flag-include-count></span></h3>
      <ul class="flag-editor__chips" data-flag-include></ul>
    </section>
    <section aria-label="Принудительно исключить">
      <h3>Принудительно исключить <span data-flag-exclude-count></span></h3>
      <ul class="flag-editor__chips" data-flag-exclude></ul>
    </section>
  </div>

  <p role="status" data-flag-feedback></p>
</fieldset>