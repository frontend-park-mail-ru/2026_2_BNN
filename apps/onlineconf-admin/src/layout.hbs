<div class="onlineconf">
  <header class="onlineconf__header">
    <a class="onlineconf__brand" href="/onlineconf/" data-onlineconf-link>
      <span class="onlineconf__logo">BNN</span>
      <span>OnlineConf</span>
    </a>
    <div class="onlineconf__account">
      <span data-admin-login></span>
    </div>
    <button
      class="onlineconf__theme"
      type="button"
      data-theme-toggle
      aria-label="Сменить тему"
      title="Сменить тему"
      aria-pressed="false"
    >
      <svg width="30" height="30" aria-hidden="true">
        <use></use>
      </svg>
    </button>
  </header>
  <div class="onlineconf__layout">
    <aside class="onlineconf__sidebar">
      <nav aria-label="Управление конфигурацией">
        <a href="/onlineconf/" data-onlineconf-link data-catalog-link>Ключи</a>
        <div class="catalog__scopes" data-scopes role="group" aria-label="Область ключей"></div>
      </nav>
    </aside>
    <main class="onlineconf__main" id="onlineconf-main"></main>
  </div>
</div>