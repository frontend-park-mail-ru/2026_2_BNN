<header class="header-block">
    <a href="/" class="logo" aria-label="На главную" data-link>
        <img src="/assets/icons/logo-shape.svg" alt="Brand New Notes">
    </a>
    <search class="search-box">
        {{> icon name="search"}}
        <input class="search-field" type="search" placeholder="Поиск по заметкам" aria-label="Поиск по заметкам" data-search>
        <button class="search-clear" type="button" aria-label="Очистить поиск" data-search-clear>
            {{> icon name="close"}}
        </button>
        <div class="search-results" data-search-results hidden></div>
    </search>
    <div class="header-actions">
        <button class="new-note-button" type="button">+ Новая заметка</button>
        <div class="user-menu">
            <button class="avatar" type="button" aria-label="Меню пользователя" aria-haspopup="true">
                <img src="/assets/images/avatar-default.svg" alt="">
            </button>
            <div class="user-menu-panel">
                <div class="user-menu-card" role="menu">
                    <a class="user-menu-item" href="/profile" role="menuitem" data-link>{{#if userLogin}}{{userLogin}}{{else}}Профиль{{/if}}</a>
                    <a class="user-menu-item" href="/settings" role="menuitem" data-link>Настройки</a>
                    <button class="user-menu-item is-danger" type="button" role="menuitem" data-logout-open>Выйти</button>
                </div>
            </div>
        </div>
    </div>
</header>
