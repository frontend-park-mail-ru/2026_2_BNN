<header class="header-block">
    <a href="/" class="logo" data-link>
        <img src="/assets/icons/logo-shape.svg">
    </a>
    <search class="search-box">
        {{> icon name="search"}}
        <input class="search-field" type="search" placeholder="Поиск по заметкам">
    </search>
    <div class="header-actions">
        <button class="new-note-button" type="button">+ Новая заметка</button>
        <a href="/user" class="avatar" data-link>{{userInitial}}</a>
    </div>
</header>
