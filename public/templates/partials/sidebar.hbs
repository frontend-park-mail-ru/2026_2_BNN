<div class="sidebar">
    <nav class="navigation">
        {{#each sections}}
            <a href="{{href}}" class="icon-button{{#if isActive}} is-active{{/if}}" aria-label="{{title}}" data-link>
                {{> icon name=icon}}
            </a>
        {{/each}}
        <div class="navigation-bottom">
            {{#with mailSection}}
                <a href="{{href}}" class="icon-button{{#if isActive}} is-active{{/if}}" aria-label="{{title}}" data-link>
                    {{> icon name=icon}}
                </a>
            {{/with}}
            <button class="icon-button theme-toggle" type="button" aria-label="Сменить тему" data-theme-toggle>
                {{> icon name="sunrise"}}
            </button>
        </div>
    </nav>
    <section class="library">
        <h2 class="library-title">{{sectionTitle}}</h2>
        <div class="library-body" data-notes-list>
            {{> notes-list}}
        </div>
    </section>
</div>
