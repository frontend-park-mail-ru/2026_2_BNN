{{#if isLoading}}
    <ul class="list-of-notes" aria-busy="true" aria-label="Загрузка заметок">
        {{#each skeletonRows}}
            <li class="card"><span class="skeleton skeleton-line"></span></li>
        {{/each}}
    </ul>
{{else if isError}}
    <p class="library-message is-error">Не удалось загрузить список</p>
{{else if isNotFound}}
    <p class="library-message">Ничего не найдено по запросу «{{query}}»</p>
{{else}}
    <ul class="list-of-notes">
        {{#each notes}}
            <li>{{> notecard}}</li>
        {{/each}}
    </ul>
{{/if}}
