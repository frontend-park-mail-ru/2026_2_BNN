<main>
    <article class="notebook">
        <div class="notebook-toolbar">
            <nav>
                <ol class="breadcrumbs">
                    {{#each breadcrumbs}}
                        <li>
                            <a href="{{href}}" data-link>{{label}}</a>
                        </li>
                    {{/each}}
                    <li>{{title}}</li>
                </ol>
            </nav>
            <div class="notebook-actions">
                <button class="icon-button" type="button">
                    {{> icon name="heart"}}
                </button>
                <button class="icon-button" type="button">
                    {{> icon name="share"}}
                </button>
                <button class="icon-button" type="button">
                    {{> icon name="menu"}}
                </button>
            </div>
        </div>
        <div class="note-content">
            <h1>{{title}}</h1>
            <p>{{text}}</p>
        </div>
    </article>
</main>
