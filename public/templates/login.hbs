<main class="login-layout login-page">
    {{> glass-filter}}
    <section class="ios-glass-panel">
        <div class="logo-text">
            <h1>Brand New Notes</h1>
        </div>
        <div class="logo"></div>
        <form class="login-form" data-form-type="login" novalidate>
            <label class="field" for="login-username">
                <span class="field-label">Логин</span>
                <input id="login-username" name="login" type="text" placeholder=" ">
                <small class="field-error" data-error-for="login"></small>
            </label>
            <label class="field" for="login-password">
                <span class="field-label">Пароль</span>
                <input id="login-password" name="password" type="password" placeholder=" ">
                <small class="field-error" data-error-for="password"></small>
            </label>
            <button class="login-button" type="submit">
                <span class="login-button-label">Войти</span>
                <span class="login-button-spinner" aria-hidden="true"></span>
            </button>
            <p class="form-feedback"></p>
            <p class="hint">Нет аккаунта? <a href="/signup" data-link>Зарегистрироваться</a></p>
        </form>
    </section>
</main>
