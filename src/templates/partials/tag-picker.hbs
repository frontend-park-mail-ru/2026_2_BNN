<div class="tag-picker" data-tag-picker>
    <input class="tag-picker__input" type="text" maxlength="30" placeholder="Найти или создать тег" aria-label="Найти или создать тег" autocomplete="off" data-tag-picker-input>
    <div class="tag-picker__list" role="menu" data-tag-picker-list>{{> tag-picker-list}}</div>
    <p class="tag-picker__error" data-tag-picker-error hidden></p>
    <button class="tag-picker__manage" type="button" data-tags-manage>Управлять тегами</button>
</div>
