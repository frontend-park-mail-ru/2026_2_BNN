<header class="header">
    <a href="/" class="header__logo" aria-label="На главную" data-link>
        <img class="header__logo-image" src="/assets/icons/logo-shape.svg" alt="Brand New Notes">
    </a>
    <search class="search">
        {{> icon name="search"}}
        <input class="search__field" type="search" placeholder="Поиск по заметкам" aria-label="Поиск по заметкам" data-search>
        <button class="search__clear" type="button" aria-label="Очистить поиск" data-search-clear>
            {{> icon name="close" size="s"}}
        </button>
        <div class="search__results" data-search-results hidden></div>
    </search>
    <div class="header__actions">
        <button class="header__create" type="button">+ Новая заметка</button>
        <div class="user-menu">
            <button class="user-menu__avatar" type="button" aria-label="Меню пользователя" aria-haspopup="true">
                <img class="user-menu__image" src="/assets/images/avatar-default.svg" alt="">
            </button>
            <div class="user-menu__panel">
                <div class="user-menu__card" role="menu">
                    <a class="user-menu__item" href="/profile" role="menuitem" data-link>{{#if userLogin}}{{userLogin}}{{else}}Профиль{{/if}}</a>
                    <a class="user-menu__item" href="/settings" role="menuitem" data-link>Настройки</a>
                    <button class="user-menu__item user-menu__item_danger" type="button" role="menuitem" data-logout-open>Выйти</button>
                </div>
            </div>
        </div>
    </div>
</header>
