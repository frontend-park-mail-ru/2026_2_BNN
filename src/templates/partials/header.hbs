<header class="header">
    <a href="/" class="header__logo" aria-label="На главную" data-link>
        <img class="header__logo-image" src="{{logoSrc}}" alt="Brand New Notes">
    </a>
    <search class="search">
        {{> icon name="search"}}
        <input class="search__field" type="search" placeholder="Поиск по заметкам" aria-label="Поиск по заметкам" data-search>
        <button class="search__clear" type="button" aria-label="Очистить поиск" data-search-clear>
            {{> icon name="close" size="s"}}
        </button>
        <div class="search__results" data-search-results hidden></div>
    </search>
    <div class="header__actions">
        <button class="header__create" type="button" data-new-note>+ Новая заметка</button>
        <div class="user-menu">
            <button class="user-menu__avatar" type="button" aria-label="Профиль пользователя" data-profile-open>
                <img class="user-menu__image" src="{{#if avatarUrl}}{{avatarUrl}}{{else}}/assets/images/avatar-default.svg{{/if}}" alt="">
            </button>
        </div>
    </div>
</header>
