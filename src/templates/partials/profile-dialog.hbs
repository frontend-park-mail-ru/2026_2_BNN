<div class="modal" data-profile-dialog hidden>
    <div class="modal__card modal__card_profile" role="dialog" aria-modal="true" aria-labelledby="profile-title">
        <div class="profile__top">
            <h2 class="profile__title" id="profile-title">Профиль</h2>
            <button class="profile__close" type="button" aria-label="Закрыть" data-profile-close>
                {{> icon name="close" size="s"}}
            </button>
        </div>

        <div data-profile-view="loading">
            <div class="profile__user">
                <span class="skeleton profile__skeleton-avatar"></span>
                <div class="profile__skeleton-text">
                    <span class="skeleton profile__skeleton-line profile__skeleton-line_name"></span>
                    <span class="skeleton profile__skeleton-line profile__skeleton-line_since"></span>
                </div>
            </div>
            <div class="profile__stats">
                <span class="skeleton profile__skeleton-stat"></span>
                <span class="skeleton profile__skeleton-stat"></span>
                <span class="skeleton profile__skeleton-stat"></span>
            </div>
            <div class="profile__menu">
                <span class="skeleton profile__skeleton-password"></span>
                <span class="skeleton profile__skeleton-logout"></span>
            </div>
        </div>

        <div data-profile-identity hidden>
            <div class="profile__user">
                <label class="profile__avatar">
                    <img class="profile__avatar-image" src="{{#if avatarUrl}}{{avatarUrl}}{{else}}/assets/images/avatar-default.svg{{/if}}" alt="">
                    <span class="login-form__spinner" aria-hidden="true"></span>
                    <span class="profile__avatar-edit">{{> icon name="camera" size="s"}}</span>
                    <input class="profile__avatar-input" type="file" accept="image/jpeg,image/png,image/webp" data-avatar-input>
                </label>
                <div>
                    <p class="profile__name" data-user-login>yourname</p>
                    <p class="profile__since" data-profile-since></p>
                </div>
            </div>
            <div class="profile__stats">
                <div class="profile__stat"><b data-stat="notes">0</b><span>заметок</span></div>
                <div class="profile__stat"><b data-stat="attachments">0</b><span>вложений</span></div>
                <div class="profile__stat"><b data-stat="favourites">0</b><span>в избранном</span></div>
            </div>
        </div>
        
        <div class="profile__menu" data-profile-view="menu" hidden>
            <button class="profile__button" type="button" data-profile-password>Сменить пароль</button>
            <button class="profile__button" type="button" data-profile-two-factor data-two-factor-action="enable">Включить защиту входа</button>
            <button class="profile__button profile__button_danger" type="button" data-profile-logout>Выйти из аккаунта</button>
        </div>

        <form class="profile-form" data-profile-view="password" data-profile-form="password" hidden novalidate>
            <label class="profile-form__field">
                <span class="profile-form__label">Текущий пароль</span>
                <span class="profile-form__control">
                    <input class="profile-form__input" name="currentPassword" type="password" autocomplete="current-password">
                    <button class="profile-form__toggle" type="button" data-password-toggle aria-label="Показать пароль">
                        {{> icon name="eye" size="s"}}
                    </button>
                </span>
                <small class="profile-form__error" data-error-for="currentPassword"></small>
            </label>
            <label class="profile-form__field">
                <span class="profile-form__label">Новый пароль</span>
                <span class="profile-form__control">
                    <input class="profile-form__input" name="newPassword" type="password" autocomplete="new-password">
                    <button class="profile-form__toggle" type="button" data-password-toggle aria-label="Показать пароль">
                        {{> icon name="eye" size="s"}}
                    </button>
                </span>
                <small class="profile-form__error" data-error-for="newPassword"></small>
            </label>
            <label class="profile-form__field">
                <span class="profile-form__label">Повторите пароль</span>
                <span class="profile-form__control">
                    <input class="profile-form__input" name="repeatPassword" type="password" autocomplete="new-password">
                    <button class="profile-form__toggle" type="button" data-password-toggle aria-label="Показать пароль">
                        {{> icon name="eye" size="s"}}
                    </button>
                </span>
                <small class="profile-form__error" data-error-for="repeatPassword"></small>
            </label>
            <div class="profile-form__actions">
                <button class="profile__button profile__button_primary" type="submit">Сохранить</button>
                <button class="profile__button" type="button" data-profile-cancel>Отмена</button>
            </div>
        </form>
        <form class="profile-form" data-profile-view="twoFactor" data-profile-form="twoFactor" hidden novalidate>
            <p class="profile-form__label profile-form__step">1. Отсканируйте QR в Google Authenticator или другом TOTP-приложении. Аккаунт будет называться BNN_Notes.</p>
            <img class="profile-form__qr" data-2fa-qr alt="QR-код для подключения 2FA" width="171" height="171">
            <div class="profile-form__field">
                <span class="profile-form__label profile-form__step">2. Введите первый код из приложения</span>
                {{> 2fa-code-input prefix="profile-form"}}
            </div>
            <div class="profile-form__actions">
                <button class="profile__button profile__button_primary" type="submit">Подтвердить</button>
                <button class="profile__button" type="button" data-profile-cancel>Отмена</button>
            </div>
        </form>
        <form class="profile-form" data-profile-view="twoFactorDisable" data-profile-form="twoFactorDisable" hidden novalidate>
            <p class="profile-form__label">Введите код из приложения, чтобы отключить защиту входа</p>
            <div class="profile-form__field">
                {{> 2fa-code-input prefix="profile-form"}}
            </div>
            <div class="profile-form__actions">
                <button class="profile__button profile__button_primary" type="submit">Отключить</button>
                <button class="profile__button" type="button" data-profile-cancel>Отмена</button>
            </div>
        </form>
    </div>
</div>
