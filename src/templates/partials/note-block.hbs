<div class="notebook__block notebook__block_{{type}}{{#if isFileCard}} notebook__block_file-card{{/if}}" data-block data-block-id="{{id}}" data-block-type="{{type}}"{{#if isAttachment}} data-content="{{contentJson}}"{{/if}}>
    {{#if isAttachment}}
        {{#if isUploading}}
            <span class="notebook__attachment-status">
                <span class="notebook__attachment-spinner" aria-hidden="true"></span>
                Загрузка: {{text}}…
            </span>
        {{else if url}}
            {{#if isImage}}
                <img class="notebook__image" src="{{url}}" alt="{{text}}" loading="lazy">
            {{else}}
                <a class="notebook__file" href="{{url}}" target="_blank" rel="noopener" download="{{text}}">
                    <span class="notebook__file-icon">
                        {{> icon name="file"}}
                    </span>
                    <span class="notebook__file-details">
                        <span class="notebook__file-name">{{text}}</span>
                        <span class="notebook__file-meta">{{fileMeta}}</span>
                    </span>
                </a>
            {{/if}}
        {{else}}
            <span class="notebook__attachment-status notebook__attachment-status_error">{{uploadError}}: {{text}}</span>
        {{/if}}
        {{#unless isUploading}}
            <button class="notebook__attachment-remove" type="button" aria-label="Удалить файл" data-attachment-remove>
                {{> icon name="close" size="s"}}
            </button>
        {{/unless}}
    {{else}}
        {{#if isChecklist}}<input class="notebook__check" type="checkbox" data-block-check {{#if checked}}checked{{/if}}>{{/if}}
        <div class="notebook__text" contenteditable="true" data-block-text>{{inline text}}</div>
    {{/if}}
</div>