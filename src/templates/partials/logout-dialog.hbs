<div class="modal" data-logout-dialog hidden>
  <div class="modal__card" role="dialog" aria-modal="true" aria-labelledby="logout-title">
    <h2 class="modal__title" id="logout-title">Выйти из аккаунта?</h2>
    <p class="modal__text">Вам потребуется повторная авторизация.</p>
    <div class="modal__actions">
      <button class="modal__button modal__button_ghost" type="button" data-logout-cancel>Отмена</button>
      <button class="modal__button" type="button" data-logout>Выйти</button>
    </div>
  </div>
</div>
