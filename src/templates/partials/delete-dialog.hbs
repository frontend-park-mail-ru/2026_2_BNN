<div class="modal" data-delete-dialog hidden>
  <div class="modal__card" role="dialog" aria-modal="true" aria-labelledby="delete-title">
    <h2 class="modal__title" id="delete-title">Удалить заметку?</h2>
    <p class="modal__text">Вы уверены, что хотите удалить?</p>
    <p class="modal__error" data-delete-error hidden></p>
    <div class="modal__actions">
      <button class="modal__button modal__button_ghost" type="button" data-delete-cancel>Отмена</button>
      <button class="modal__button modal__button_danger" type="button" data-delete>
        Удалить
        <span class="modal__spinner"></span>
      </button>
    </div>
  </div>
</div>