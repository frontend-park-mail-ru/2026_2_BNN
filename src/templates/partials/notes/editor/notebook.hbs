<article class="notebook">
    <div class="notebook__toolbar">
        <nav class="notebook__nav" aria-label="Путь к заметке">
            {{#if hasAncestors}}
                <div class="note-path__inline">
                    <div class="note-path__trail">
                        {{#each breadcrumbs}}
                            <a class="note-path__root" href="{{href}}" data-link>{{label}}</a>
                            <span aria-hidden="true">›</span>
                        {{/each}}
                        <span aria-current="page" data-current-crumb>{{displayTitle}}</span>
                    </div>
                </div>
            {{/if}}
            <a class="note-path__root" href="{{breadcrumbs.[0].href}}" data-link>
                Все заметки
            </a>
            <span aria-hidden="true">›</span>

            {{#if hasAncestors}}
                <details class="note-path__details">
                    <summary class="note-path__summary" title="Показать путь к заметке">
                        <span class="note-path__more" aria-hidden="true">…</span>
                        <span aria-hidden="true">›</span>
                        <span class="note-path__title" data-current-crumb>{{displayTitle}}</span>
                        <span class="note-path__sr-only"> — полный путь к заметке</span>
                    </summary>

                    <ol class="note-path__full" aria-label="Полный путь">
                        {{#each breadcrumbs}}
                            <li>
                                <a class="note-path__entry" href="{{href}}" data-link>
                                    <span aria-hidden="true">{{> icon name="file"}}</span>
                                    {{label}}
                                </a>
                            </li>
                        {{/each}}
                        <li class="note-path__entry" aria-current="page">
                            <span aria-hidden="true">{{> icon name="file"}}</span>
                            <span data-current-crumb>{{displayTitle}}</span>
                            <span class="note-path__check" aria-hidden="true">✓</span>
                        </li>
                    </ol>
                </details>
            {{else}}
                <span class="note-path__title" aria-current="page" data-current-crumb>
                    {{displayTitle}}
                </span>
            {{/if}}
        </nav>
        <span class="notebook__voice-input-status" data-voice-input-status aria-live="polite" hidden></span>
        <span class="notebook__save-status" data-save-status>{{saveStatus}}</span>
        <div class="notebook__actions">
            {{#if canUseVoiceInput}}
                <button class="icon-button" type="button" aria-label="Голосовой ввод" aria-pressed="false" title="Голосовой ввод" data-voice-input-toggle>
                    {{> icon name="mic"}}
                </button>
            {{/if}}
            <button class="icon-button icon-button_disabled" type="button" aria-label="Избранное" disabled>
                {{> icon name="heart"}}
            </button>
            <button class="icon-button icon-button_disabled" type="button" aria-label="Поделиться" disabled>
                {{> icon name="share"}}
            </button>
            <div class="note-menu" data-note-menu>
                <button class="icon-button" type="button" aria-label="Действия с заметкой" aria-haspopup="menu" aria-expanded="false" data-note-menu-toggle>
                    {{> icon name="menu"}}
                </button>
                <div class="note-menu__panel" role="menu" data-note-menu-panel hidden>
                    <button class="note-menu__item note-menu__item_danger" type="button" role="menuitem" data-delete-open>Удалить</button>
                </div>
            </div>
        </div>
    </div>
    <div class="notebook__content">
        {{#if hasNote}}<h1 class="notebook__title" contenteditable="plaintext-only" data-note-title data-placeholder="Без названия">{{title}}</h1>
        <div class="note-tags" data-note-tags-root>
            <div class="note-tags__list" data-note-tags>{{> note-tags}}</div>
        </div>
        <div class="notebook__body" data-note-body>{{#each blocks}}{{> note-block}}{{/each}}</div>
        {{/if}}
    </div>
</article>
