<article class="notebook">
    <div class="notebook__toolbar">
        <nav class="notebook__nav" aria-label="Путь к заметке">
            {{> note-path}}
        </nav>
        <span class="notebook__voice-input-status" data-voice-input-status aria-live="polite" hidden></span>
        <span class="notebook__save-status" data-save-status>{{saveStatus}}</span>
        <div class="notebook__actions">
            <button class="icon-button" type="button" data-add-block aria-label="Добавить блок" title="Добавить блок">
                {{> icon name="plus"}}
            </button>
            {{#if canUseVoiceInput}}
                <button class="icon-button" type="button" aria-label="Голосовой ввод" aria-pressed="false" title="Голосовой ввод" data-voice-input-toggle>
                    {{> icon name="mic"}}
                </button>
            {{/if}}
            <button class="icon-button icon-button_disabled" type="button" aria-label="Избранное" disabled>
                {{> icon name="heart"}}
            </button>
            <button class="icon-button icon-button_disabled" type="button" aria-label="Поделиться" disabled>
                {{> icon name="share"}}
            </button>
            <div class="note-menu" data-note-menu>
                <button class="icon-button" type="button" aria-label="Действия с заметкой" aria-haspopup="menu" aria-expanded="false" data-note-menu-toggle>
                    {{> icon name="menu"}}
                </button>
                <div class="note-menu__panel" role="menu" data-note-menu-panel hidden>
                    <button class="note-menu__item note-menu__item_danger" type="button" role="menuitem" data-delete-open>Удалить</button>
                </div>
            </div>
        </div>
    </div>
    <div class="notebook__content">
        {{> note-content}}
    </div>
</article>
