{{#if isConnectionLost}}
    <article class="notebook notebook_centered">
        <div class="notebook__message">
            <span class="notebook__status notebook__status_error">{{> icon name="alert" size="l"}}</span>
            <h2 class="notebook__message-title">Потеря соединения</h2>
            <p class="notebook__message-text">Эти данные ещё не загружались.<br>Они откроются, когда появится интернет</p>
            <button class="notebook__action notebook__action_secondary" type="button" data-retry>Повторить</button>
        </div>
    </article>
{{else if isLoading}}
    <article class="notebook notebook_busy" aria-busy="true">
        <div class="notebook__toolbar">
            <span class="skeleton skeleton_line skeleton_crumbs"></span>
            <div class="notebook__actions notebook__actions_disabled">
                {{> icon name="folder-heart"}}
                {{> icon name="share"}}
                {{> icon name="trash"}}
            </div>
        </div>
        <div class="notebook__content">
            {{#each skeletonRows}}
                <span class="skeleton skeleton_line"></span>
            {{/each}}
        </div>
    </article>
{{else if isMainError}}
    <article class="notebook notebook_centered">
        <div class="notebook__message">
            <span class="notebook__status notebook__status_error">{{> icon name="alert" size="l"}}</span>
            <h2 class="notebook__message-title">{{#if isNoteError}}Не удалось загрузить заметку{{else}}Не удалось загрузить заметки{{/if}}</h2>
            <p class="notebook__message-text">Технические неполадки, попробуйте позже</p>
            <button class="notebook__action notebook__action_secondary" type="button" data-retry>Повторить</button>
        </div>
    </article>
{{else if isFavoritesOverview}}
    <article class="notebook notebook_centered">
        <div class="notebook__message">
            <span class="notebook__status">{{> icon name="folder-heart" size="l"}}</span>
            {{#if hasFavorites}}
                <h2 class="notebook__message-title">Избранное</h2>
                <p class="notebook__message-text">Выберите заметку в списке</p>
            {{else}}
                <h2 class="notebook__message-title">Пока нет избранных заметок</h2>
                <p class="notebook__message-text">Нажмите на сердечко в заметке, чтобы добавить её сюда</p>
            {{/if}}
        </div>
    </article>
{{else if isEmpty}}
    <article class="notebook notebook_centered">
        <div class="notebook__message">
            <span class="notebook__status">{{> icon name="file" size="l"}}</span>
            <h2 class="notebook__message-title">У вас пока нет заметок</h2>
            <p class="notebook__message-text">Создайте первую заметку, и она появится здесь</p>
            <button class="notebook__action" type="button" data-new-note>Создать заметку</button>
        </div>
    </article>
{{else if isWelcome}}
    <article class="notebook notebook_centered">
        <div class="notebook__message">
            <span class="notebook__status">{{> icon name="file" size="l"}}</span>
            <h2 class="notebook__message-title">
                {{#if isAllNotes}}Все заметки{{else}}Добро пожаловать{{/if}}
            </h2>
            <p class="notebook__message-text">Выберите заметку<br>или создайте новую</p>
            <button class="notebook__action" type="button" data-new-note>Создать заметку</button>
        </div>
    </article>
{{else}}
    {{> notebook}}
{{/if}}
