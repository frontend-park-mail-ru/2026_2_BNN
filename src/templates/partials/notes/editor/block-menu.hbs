<div class="block-menu" data-block-menu tabindex="-1" role="group" aria-label="Тип блока">
    <p class="block-menu__title">Базовые блоки</p>
    {{#each options}}
        <button class="block-menu__item{{#if @first}} block-menu__item_active{{/if}}" type="button" data-block-option="{{type}}">{{label}}</button>
    {{/each}}
</div>
