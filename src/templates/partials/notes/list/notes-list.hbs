{{#if isListLoading}}
    <ul class="sidebar__list" aria-busy="true" aria-label="Загрузка заметок">
        {{#each skeletonRows}}
            <li class="card"><span class="skeleton skeleton_line"></span></li>
        {{/each}}
    </ul>
{{else if isListError}}
    <p class="sidebar__message sidebar__message_error">Не удалось загрузить список</p>
{{else}}
    {{> tag-filter}}
    {{#if isFilterLoading}}
        <p class="sidebar__message" role="status">Ищем заметки с этими тегами…</p>
    {{else}}
        {{#if isFilterIncomplete}}
            <p class="sidebar__message" role="status">Не удалось проверить все заметки. <button type="button" data-retry>Повторить</button></p>
        {{else if isFilterEmpty}}
            <p class="sidebar__message">Нет заметок с выбранными тегами</p>
        {{/if}}
        <ul class="sidebar__list note-tree" aria-label="Заметки">
            {{#each notes}}
                {{> note-tree-item}}
            {{/each}}
        </ul>
    {{/if}}
{{/if}}
