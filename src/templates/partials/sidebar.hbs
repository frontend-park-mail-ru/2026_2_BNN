<div class="sidebar">
    <nav class="sidebar__nav">
        {{#each sections}}
            <a
                href="{{href}}"
                class="icon-button{{#if isActive}} icon-button_active{{/if}}{{#unless @first}} icon-button_disabled{{/unless}}"
                aria-label="{{title}}"
                {{#if @first}}data-link{{else}}aria-disabled="true" tabindex="-1"{{/if}}
            >
                {{> icon name=icon}}
            </a>
        {{/each}}
        <div class="sidebar__nav-end">
            {{#with mailSection}}
                <a
                    href="{{href}}"
                    class="icon-button{{#if isActive}} icon-button_active{{/if}} icon-button_disabled"
                    aria-label="{{title}}"
                    aria-disabled="true"
                    tabindex="-1"
                >
                    {{> icon name=icon}}
                </a>
            {{/with}}
            <button
                class="icon-button icon-button_theme icon-button_disabled"
                type="button"
                aria-label="Сменить тему"
                data-theme-toggle
                disabled
            >
                {{> icon name="sunset"}}
            </button>
        </div>
    </nav>
    <section class="sidebar__library">
        <h2 class="sidebar__title">{{sectionTitle}}</h2>
        <div class="sidebar__body" data-notes-list>
            {{> notes-list}}
        </div>
    </section>
</div>
