<div class="modal" data-tags-dialog hidden>
    <div class="modal__card modal__card_tags" role="dialog" aria-modal="true" aria-labelledby="tags-title">
        <div class="tags-dialog__top">
            <h2 class="modal__title" id="tags-title">Теги</h2>
            <button class="tags-dialog__close" type="button" aria-label="Закрыть" data-tags-close>
                {{> icon name="close" size="s"}}
            </button>
        </div>
        <div class="tags-dialog__body" data-tags-body></div>
    </div>
</div>
