{{#each noteTags}}
    <span class="tag" data-tag-color="{{color}}" title="{{name}}" data-note-tag="{{id}}">
        <span class="tag__name">{{name}}</span>
        <button class="tag__remove" type="button" aria-label="Убрать тег {{name}}" data-note-tag-remove="{{id}}">
            {{> icon name="close" size="s"}}
        </button>
    </span>
{{/each}}
<button class="note-tags__add" type="button" aria-haspopup="true" aria-expanded="false" aria-label="Добавить тег" data-tag-picker-open>
    {{> icon name="tag" size="s"}}
    {{#unless noteTags.length}}<span>Добавить тег</span>{{/unless}}
</button>
