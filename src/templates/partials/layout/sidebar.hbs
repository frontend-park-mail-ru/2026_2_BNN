<div class="sidebar-backdrop" hidden></div>
<div class="sidebar" id="notes-sidebar">
    <nav class="sidebar__nav">
        {{#each sections}}
            <a
                href="{{href}}"
                class="icon-button{{#if isActive}} icon-button_active{{/if}}{{#unless enabled}} icon-button_disabled{{/unless}}"
                aria-label="{{title}}"
                {{#if isActive}}aria-current="page"{{/if}}
                {{#if enabled}}data-link{{else}}aria-disabled="true" tabindex="-1"{{/if}}
            >
                {{> icon name=icon}}
            </a>
        {{/each}}
        <div class="sidebar__nav-end">
            {{#with mailSection}}
                <a
                    href="{{href}}"
                    class="icon-button{{#if isActive}} icon-button_active{{/if}} icon-button_disabled"
                    aria-label="{{title}}"
                    aria-disabled="true"
                    tabindex="-1"
                >
                    {{> icon name=icon}}
                </a>
            {{/with}}
            <button
                class="icon-button icon-button_theme"
                type="button"
                aria-label="Сменить тему"
                data-theme-toggle
            >
                {{> icon name=themeIcon}}
            </button>
        </div>
    </nav>
    <section class="sidebar__library">
        <div class="sidebar__heading">
            <h2 class="sidebar__title" id="sidebar-title">{{sectionTitle}}</h2>
            <button type="button" class="icon-button sidebar__close" aria-label="Закрыть список заметок">{{> icon name="close" size="s"}}</button>
        </div>
        <div class="sidebar__body" data-notes-list>
            {{> notes-list}}
        </div>
        <button class="header__create sidebar__create" type="button" data-new-note>+ Новая заметка</button>
    </section>
</div>
