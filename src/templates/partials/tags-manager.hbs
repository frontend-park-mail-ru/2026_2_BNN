{{#with createForm}}{{> tag-form}}{{/with}}
{{#if tags.length}}
    <ul class="tags-list">
        {{#each tags}}
            <li class="tags-list__item">
                {{#if form}}
                    {{#with form}}{{> tag-form}}{{/with}}
                {{else}}
                    <span class="tag" style="--tag-color: {{color}}" title="{{{name}}}"><span class="tag__name">{{{name}}}</span></span>
                    <div class="tags-list__actions">
                        <button class="tags-list__button" type="button" aria-label="Изменить тег {{{name}}}" data-tag-edit="{{id}}">
                            {{> icon name="pencil" size="s"}}
                        </button>
                        <button class="tags-list__button tags-list__button_danger{{#if isConfirming}} tags-list__button_confirm{{/if}}" type="button" aria-label="Удалить тег {{{name}}}" data-tag-delete="{{id}}">
                            {{#if isConfirming}}Удалить?{{else}}{{> icon name="trash" size="s"}}{{/if}}
                        </button>
                    </div>
                {{/if}}
            </li>
        {{/each}}
    </ul>
{{else}}
    <p class="tags-list__empty">Тегов пока нет. Созданный тег появится в фильтре и в заметках</p>
{{/if}}
<p class="tags-list__error" data-tags-error{{#unless error}} hidden{{/unless}}>{{error}}</p>
