<article class="notebook">
    <div class="notebook__toolbar">
        <nav class="notebook__nav">
            <ol class="notebook__crumbs">
                {{#each breadcrumbs}}
                    <li class="notebook__crumb">
                        <a class="notebook__link" href="{{href}}" data-link>{{label}}</a>
                    </li>
                {{/each}}
                {{#if hasNote}}<li class="notebook__crumb">{{displayTitle}}</li>{{/if}}
            </ol>
        </nav>
        <span class="notebook__save-status" data-save-status>{{saveStatus}}</span>
        <div class="notebook__actions">
            <button class="icon-button" type="button">
                {{> icon name="heart"}}
            </button>
            <button class="icon-button" type="button">
                {{> icon name="share"}}
            </button>
            <div class="note-menu" data-note-menu>
                <button class="icon-button" type="button" aria-label="Действия с заметкой" aria-haspopup="menu" aria-expanded="false" data-note-menu-toggle>
                    {{> icon name="menu"}}
                </button>
                <div class="note-menu__panel" role="menu" data-note-menu-panel hidden>
                    <button class="note-menu__item" type="button" role="menuitem" disabled>Поделиться</button>
                    <button class="note-menu__item note-menu__item_danger" type="button" role="menuitem" data-delete-open>Удалить</button>
                </div>
            </div>
        </div>
    </div>
    <div class="notebook__content">
        {{#if hasNote}}<h1 class="notebook__title" contenteditable="true" data-note-title data-placeholder="Без названия">{{title}}</h1>
        <div class="notebook__body" data-note-body>{{#each blocks}}{{> note-block}}{{/each}}</div>
        {{/if}}
    </div>
</article>
