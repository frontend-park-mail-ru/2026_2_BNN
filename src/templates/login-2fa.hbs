<main class="login">
    {{> glass-filter}}
    <section class="login__panel">
        <div class="login__brand">
            <div class="login__brand-row">
                <div class="login__logo" aria-hidden="true"></div>
                <h1 class="login__title">Brand New Notes</h1>
            </div>
            <p class="login__tagline">Двухфакторная аутентификация</p>
        </div>
        <form class="login-form" data-form-type="login-2fa" novalidate>
            <p class="login-form__intro">Введите 6 цифр из приложения-аутентификатора</p>
            <div class="login-form__field">
                <div class="login-form__code">
                    <input class="login-form__digit" data-2fa-digit type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code" aria-label="Цифра 1">
                    <input class="login-form__digit" data-2fa-digit type="text" inputmode="numeric" maxlength="1" aria-label="Цифра 2">
                    <input class="login-form__digit" data-2fa-digit type="text" inputmode="numeric" maxlength="1" aria-label="Цифра 3">
                    <input class="login-form__digit" data-2fa-digit type="text" inputmode="numeric" maxlength="1" aria-label="Цифра 4">
                    <input class="login-form__digit" data-2fa-digit type="text" inputmode="numeric" maxlength="1" aria-label="Цифра 5">
                    <input class="login-form__digit" data-2fa-digit type="text" inputmode="numeric" maxlength="1" aria-label="Цифра 6">
                </div>
                <small class="login-form__error" data-error-for="code"></small>
            </div>
            <button class="login-form__submit" type="submit">
                <span class="login-form__submit-label">Подтвердить</span>
                <span class="login-form__spinner" aria-hidden="true"></span>
            </button>
            <p class="login-form__feedback"></p>
            <p class="login-form__hint"><a class="login-form__link" href="/login" data-link>Вернуться ко входу</a></p>
        </form>
    </section>
</main>
