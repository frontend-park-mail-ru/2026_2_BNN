<main class="login">
    {{> glass-filter}}
    <section class="login__panel">
        <div class="login__brand">
            <div class="login__brand-row">
                <div class="login__logo" aria-hidden="true"></div>
                <h1 class="login__title">Brand New Notes</h1>
            </div>
            <p class="login__tagline">Ваши заметки и мысли – в уютном месте</p>
        </div>
        <form class="login-form" data-form-type="login" novalidate>
            <label class="login-form__field" for="login-username">
                <span class="login-form__label">Логин</span>
                <input class="login-form__input" id="login-username" name="login" type="text" placeholder=" ">
                <small class="login-form__error" data-error-for="login"></small>
            </label>
            <label class="login-form__field" for="login-password">
                <span class="login-form__label">Пароль</span>
                <input class="login-form__input" id="login-password" name="password" type="password" placeholder=" ">
                <small class="login-form__error" data-error-for="password"></small>
            </label>
            <button class="login-form__submit" type="submit">
                <span class="login-form__submit-label">Войти</span>
                <span class="login-form__spinner" aria-hidden="true"></span>
            </button>
            <p class="login-form__feedback"></p>
            <p class="login-form__hint">Нет аккаунта? <a class="login-form__link" href="/signup" data-link>Зарегистрироваться</a></p>
        </form>
    </section>
</main>
